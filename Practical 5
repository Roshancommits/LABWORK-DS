#include <stdio.h>
#include <stdlib.h>
#define SIZE 5
void enqueue();
void dequeue();
void display();
int front = -1, rear = -1, ch, que_arr[SIZE];
void main() {
while (1) {
printf("\n1. Enqueue \n2. Dequeue \n3. Display \n4. Exit\n");
printf("ch: ");
scanf("%d", &ch);
switch (ch) {
case 1:
enqueue();
break;
case 2:
dequeue();
break;
case 3:
display();
break;
case 4:
exit(0);
default:
printf("Invalid!");
}
}
}
void enqueue() {
int data;
if (rear == SIZE - 1) {
printf("Queue is full\n");
} else {
if (front == -1) {
front = 0;
}
printf("Data: ");
scanf("%d", &data);
rear = rear + 1;
que_arr[rear] = data;
}
}
void dequeue() {
if (front == -1) {
printf("Queue is empty\n");
} else {
printf("Deleted element: %d\n", que_arr[front]);
front = front + 1;
}
}
void display() {
int i;
if (front == -1) {
printf("Empty");
} else {
for (i = front; i <= rear; i++) {
printf("%d\t", que_arr[i]);
}
}
}
