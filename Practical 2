#include <stdio.h>
#include <stdlib.h>
void main() {
int a[5], i, del, srch, s = 5, ch, key, pos;
while (1) {
printf("\n Array Operations:\n1. Insertion\t2. Traversal\t3. Searching\t4. Deletion\t5. Exit\n");
printf("Enter your option: ");
scanf("%d", &ch);
switch (ch) {
case 1:
s = 5;
for (i = 0; i < s; i++) {
    printf("Arr[%d] = ", i);
scanf("%d", &a[i]);
}
break;
case 2:
if (s == 0) {
printf("Array is empty\n");
} else {
printf("Array elements are: ");
for (i = 0; i < s; i++) {
printf("%d ", a[i]);
}
printf("\n");
}
break;
case 3:
if (s == 0) {
    printf("Array is empty\n");
} else {
printf("Enter element to search: ");
scanf("%d", &srch);
int found = 0;
for (i = 0; i < s; i++) {
if (a[i] == srch) {
printf("Element %d found at index %d\n", srch, i);
found = 1;
break;
}
}
if (!found) {
printf("Element not found\n");
}
}
break;
case 4:
if (s == 0) {
printf("Enter index to delete (0 to %d): ", s - 1);
scanf("%d", &pos);
if (pos < 0 || pos >= s) {
printf("invalid index position!\n");
} else {
for (i = pos; i < s - 1; i++) {
a[i] = a[i + 1];
}
s--;
printf("Element deleted successfully\n");
}
}
break;
case 5:
printf("Exiting program\n");
exit(0);
default:
printf("Invalid choice! Please choose between 1 and 5\n");
}
}
}